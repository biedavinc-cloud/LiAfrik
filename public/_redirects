# Redirect the bare root to the default language at the edge — instant
# HTTP redirect, before any JS downloads or runs. Previously this was a
# client-side redirect (React Router), which meant the browser had to
# download the full JS bundle, hydrate, and THEN navigate before any
# content painted — a major hit to LCP/FCP for anyone hitting the bare
# domain (which is the most common URL for people/tools to test).
# Matches the "x-default" hreflang, which already points to /en.
/  /en  302

# Zando was renamed to Zanldo — redirect the old product slug to the
# new one for each language, so any link already shared/indexed under
# the old name still lands on the right page instead of a 404.
/en/products/zando  /en/products/zanldo  301
/fr/products/zando  /fr/products/zanldo  301
/ar/products/zando  /ar/products/zanldo  301
/es/products/zando  /es/products/zanldo  301
/pt/products/zando  /pt/products/zanldo  301

# Old language-less URLs → default language, at the edge (no JS needed).
/products  /en/products  302
/products/*  /en/products/:splat  302
/alternatives  /en/alternatives  302
/alternatives/*  /en/alternatives/:splat  302
/security  /en/security  302
/founder  /en/founder  302
/presence  /en/presence  302
/partners  /en/partners  302
/support  /en/support  302
/privacy  /en/privacy  302
/terms  /en/terms  302
/refund  /en/refund  302

# NOTE: there is deliberately NO catch-all ("/*  /index.html  200") any more.
# Every real page is a pre-rendered file (scripts/prerender.mjs), so any other
# URL now gets dist/404.html with a true HTTP 404 instead of a 200 "soft 404"
# that search engines would treat as a thin, duplicate page.
